# ============================================================
# Ferretería Los Maestros — Frontend React (Vite)
# URL base de la API del backend Spring Boot (monolito)
# ============================================================
# Local (backend corriendo en el equipo):
VITE_API_BASE_URL=http://localhost:8080

# Producción (backend en Render):
# VITE_API_BASE_URL=https://ferreteria-backend.onrender.com

# Catálogo simulado mientras el backend del módulo producto no esté listo.
# true  -> usa src/api/mock.js
# false -> consume la API real en VITE_API_BASE_URL
VITE_USAR_MOCK=true
